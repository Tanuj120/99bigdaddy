<!DOCTYPE html>
<html translate="no" data-dpr="1" style="font-size: 37.52px;">

<head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="robots" content="noindex,nofollow">
    <meta content="width=device-width,initial-scale=1,maximum-scale=1,user-scalable=no" name="viewport">
    <title>Change Email - Drakon</title>
    <link href="/css/member/main.css" rel="stylesheet">
    <link href="/css/home/app.css" rel="stylesheet">
    <link rel="shortcut icon" href="/images/drakon-mark.svg" type="image/x-icon">
    <style>
        html,
        body {
            min-height: 100%;
            width: 100%;
            margin: 0;
            background: #e8f5ff;
        }

        .email-page {
            min-height: 100vh;
            padding-bottom: .8rem;
            background: #e8f5ff;
        }

        .email-card {
            margin: .55rem .4rem;
            padding: .5rem .4rem .6rem;
            border: .02667rem solid #c7e3f8;
            border-radius: .4rem;
            background: #fff;
            box-shadow: 0 .16rem .5rem rgba(31, 91, 145, .12);
        }

        .email-card h1 {
            margin: 0 0 .12rem;
            color: #142a3d;
            font-size: .53rem;
        }

        .email-card .subtitle {
            margin-bottom: .45rem;
            color: #6d8194;
            font-size: .34rem;
            line-height: 1.5;
        }

        .field {
            margin-bottom: .38rem;
        }

        .field label {
            display: block;
            margin-bottom: .14rem;
            color: #243746;
            font-size: .35rem;
            font-weight: 700;
        }

        .field input {
            width: 100%;
            height: 1.15rem;
            padding: 0 .34rem;
            border: .02667rem solid #bdd8eb;
            border-radius: .24rem;
            background: #f9fcff;
            color: #172b3a;
            font-size: .38rem;
            box-sizing: border-box;
        }

        .field input:focus {
            border-color: #278fe8;
            box-shadow: 0 0 0 .08rem rgba(39, 143, 232, .14);
        }

        .field input[readonly] {
            color: #667b8d;
            background: #eef5fa;
        }

        .submit-button {
            width: 100%;
            height: 1.18rem;
            margin-top: .12rem;
            border: 0;
            border-radius: 99rem;
            color: #fff;
            background: linear-gradient(90deg, #278fe8, #50b9f4);
            box-shadow: 0 .14rem .34rem rgba(39, 143, 232, .28);
            font-size: .42rem;
            font-weight: 800;
            cursor: pointer;
        }

        .submit-button:disabled {
            opacity: .65;
            cursor: wait;
        }

        .form-message {
            display: none;
            margin: 0 0 .35rem;
            padding: .25rem .3rem;
            border-radius: .2rem;
            font-size: .34rem;
            line-height: 1.45;
        }

        .form-message.error {
            display: block;
            color: #a82929;
            background: #ffeded;
        }

        .form-message.success {
            display: block;
            color: #176b37;
            background: #e9f9ef;
        }
    </style>
</head>

<body>
    <main class="mian email-page" data-v-9f3a9836="">
        <div class="navbar" data-v-106b99c8="">
            <div class="navbar-left" data-v-106b99c8="" onclick="location.href='/myProfile'">
                <div class="bank c-row c-row-middle-center" data-v-106b99c8="">
                    <img src="/images/back.c3244ab0.png" class="navbar-back" alt="Back" data-v-106b99c8="">
                </div>
            </div>
            <div class="navbar-title" data-v-106b99c8="">Change Email</div>
            <div class="navbar-right" data-v-106b99c8=""></div>
        </div>

        <section class="email-card">
            <h1>Update Email Address</h1>
            <p class="subtitle">Confirm your account password before saving your new email address.</p>
            <div id="formMessage" class="form-message" role="status" aria-live="polite"></div>

            <form id="changeEmailForm" autocomplete="off" novalidate>
                <div class="field">
                    <label for="oldEmail">Old Email</label>
                    <input id="oldEmail" name="oldEmail" type="email" value="<%= currentEmail %>"
                        placeholder="No email registered" autocomplete="email" readonly>
                </div>
                <div class="field">
                    <label for="newEmail">New Email</label>
                    <input id="newEmail" name="newEmail" type="email" maxlength="191"
                        placeholder="Enter your new email" autocomplete="off" inputmode="email"
                        autocapitalize="none" spellcheck="false" data-lpignore="true" data-1p-ignore required>
                </div>
                <div class="field">
                    <label for="confirmEmail">Confirm New Email</label>
                    <input id="confirmEmail" name="confirmEmail" type="email" maxlength="191"
                        placeholder="Re-enter your new email" autocomplete="off" inputmode="email"
                        autocapitalize="none" spellcheck="false" data-lpignore="true" data-1p-ignore required>
                </div>
                <div class="field">
                    <label for="password">Password</label>
                    <input id="password" name="password" type="password"
                        placeholder="Enter your account password" autocomplete="off"
                        data-lpignore="true" data-1p-ignore required>
                </div>
                <button id="submitButton" class="submit-button" type="submit">Update Email</button>
            </form>
        </section>
    </main>

    <script>
        const form = document.getElementById('changeEmailForm');
        const submitButton = document.getElementById('submitButton');
        const messageBox = document.getElementById('formMessage');
        const newEmailInput = document.getElementById('newEmail');
        const confirmEmailInput = document.getElementById('confirmEmail');

        function clearPhoneAutofill() {
            [newEmailInput, confirmEmailInput].forEach((input) => {
                if (/^\+?[\d\s()-]{8,}$/.test(input.value.trim())) {
                    input.value = '';
                }
            });
        }

        clearPhoneAutofill();
        window.addEventListener('pageshow', clearPhoneAutofill);
        [50, 250, 750].forEach((delay) => setTimeout(clearPhoneAutofill, delay));
        newEmailInput.addEventListener('focus', clearPhoneAutofill);
        confirmEmailInput.addEventListener('focus', clearPhoneAutofill);

        function showMessage(message, type) {
            messageBox.textContent = message;
            messageBox.className = `form-message ${type}`;
        }

        form.addEventListener('submit', async function (event) {
            event.preventDefault();
            const newEmail = document.getElementById('newEmail').value.trim().toLowerCase();
            const confirmEmail = document.getElementById('confirmEmail').value.trim().toLowerCase();
            const password = document.getElementById('password').value;

            if (!newEmail || !confirmEmail || !password) {
                showMessage('Please complete all required fields', 'error');
                return;
            }

            if (newEmail !== confirmEmail) {
                showMessage('New email addresses do not match', 'error');
                return;
            }

            submitButton.disabled = true;
            submitButton.textContent = 'Updating...';

            try {
                const response = await fetch('/api/webapi/change/email', {
                    method: 'PUT',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        oldEmail: document.getElementById('oldEmail').value,
                        newEmail,
                        confirmEmail,
                        password,
                    }),
                });
                const data = await response.json();
                showMessage(data.message || 'Unable to update email address', data.status ? 'success' : 'error');

                if (data.status) {
                    document.getElementById('oldEmail').value = data.email;
                    form.reset();
                    document.getElementById('oldEmail').value = data.email;
                    setTimeout(() => location.href = '/myProfile', 900);
                }
            } catch (error) {
                showMessage('Unable to update email address. Please try again', 'error');
            } finally {
                submitButton.disabled = false;
                submitButton.textContent = 'Update Email';
            }
        });
    </script>
</body>

</html>
